<!DOCTYPE html>
<html
  lang="en"
  class="[scrollbar-gutter:stable]"
  data-user-theme={
    case assigns[:current_scope] do
      %{user: %{theme: theme}} when not is_nil(theme) -> to_string(theme)
      _ -> nil
    end
  }
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Trygg" suffix=" · Trygg">
      {assigns[:page_title]}
    </.live_title>

    <%!-- Literal path on purpose: `~p` would resolve to the digested
         `/manifest-<hash>.webmanifest` in prod, which Plug.Static's `:only`
         exact-match list rejects (404). Installed apps also key on a stable
         manifest URL. --%>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Trygg" />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/icon-180.png"} />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Pre-paint theme bootstrap: must run before first paint to avoid a
         flash, so it stays inline here rather than in app.js (which is
         `defer`red). The live toggle lives in the `Theme` hook; keep the two
         in sync. --%>
    <script>
      (() => {
        const root = document.documentElement;
        // Signed in: `data-user-theme` is the server-stored choice and wins.
        // Signed out: fall back to whatever this device last chose.
        const serverTheme = root.dataset.userTheme;
        let theme = "system";
        try {
          theme = serverTheme || localStorage.getItem("phx:theme") || "system";
          // Mirror the server choice so it survives sign-out and carries to
          // other tabs on this device.
          if (serverTheme) {
            if (theme === "system") {
              localStorage.removeItem("phx:theme");
            } else {
              localStorage.setItem("phx:theme", theme);
            }
          }
        } catch (_e) {
          theme = serverTheme || "system";
        }
        if (theme === "system") {
          root.removeAttribute("data-theme");
        } else {
          root.setAttribute("data-theme", theme);
        }
        window.addEventListener("storage", (e) => {
          if (e.key !== "phx:theme") return;
          const next = e.newValue || "system";
          if (next === "system") {
            root.removeAttribute("data-theme");
          } else {
            root.setAttribute("data-theme", next);
          }
        });
      })();
    </script>
  </head>
  <body class="bg-base-100">
    {@inner_content}
  </body>
</html>
